datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id           String   @id @default(uuid())
    email        String   @unique
    name         String
    passwordHash String
    balance      BigInt   @default(20000000)
    createdAt    DateTime @default(now())
}
